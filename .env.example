# =============================================================================
#  Kopiraj to datoteko v ".env" in vpiši svoje vrednosti:
#      cp .env.example .env        (Linux/Mac)
#      Copy-Item .env.example .env (Windows PowerShell)
# =============================================================================

# --- OBVEZNO: OpenAI API ključ (za AI strukturiranje in embeddinge) ----------
OPENAI_API_KEY=

# --- OpenAI modeli (privzeto poceni in zmogljivo; lahko spremeniš) -----------
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- MySQL (relacijska baza) -------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=companiesdb
MYSQL_PORT=3307

# --- Qdrant (vektorska baza) -------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_COLLECTION=company_chunks

# --- Vrata storitev na gostitelju --------------------------------------------
BIND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8081
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# --- Nastavitve pipelina (zajem in obdelava) ---------------------------------
SCRAPE_MAX_PAGES=40
SCRAPE_MAX_DEPTH=2
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
